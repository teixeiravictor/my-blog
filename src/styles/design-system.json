{
  "grid": {
    "container": "130rem",
    "gutter": "3.2rem"
  },
  "border": {
    "radius": "0.4rem"
  },
  "font": {
    "family": {
      "primary": "IBM Plex Sans, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif",
      "secondary": "IBM Plex Serif, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', serif"
    },
    "bold": 600,
    "lineHeight": {
      "small": "1.1",
      "medium": "1.2",
      "large": "1.5",
      "xlarge": "1.7",
      "xxlarge": "2.4"
    },
    "sizes": {
      "xxxsmall": "1.2rem",
      "xxsmall": "1.6rem",
      "xsmall": "2.1rem",
      "small": "2.8rem",
      "medium": "3.8rem",
      "large": "5rem",
      "xlarge": "6.7rem",
      "xxlarge": "8.9rem"
    }
  },
  "typography": {
    "heading1": { "fontSize": "xxlarge", "tag": "h1" },
    "heading2": { "fontSize": "xlarge", "tag": "h2" },
    "heading3": { "fontSize": "large", "tag": "h3" },
    "heading4": { "fontSize": "medium", "tag": "h4" },
    "heading5": { "fontSize": "small", "tag": "h5" },
    "heading6": { "fontSize": "xsmall", "tag": "h6" },
    "paragraph": { "fontSize": "xxsmall", "tag": "p" },
    "small": { "fontSize": "xxxsmall", "tag": "small" }
  },
  "colors": {
    "primary": {
      "default": "#132A72",
      "light": "#394772",
      "dark": "#0B1842"
    },
    "secondary": {
      "default": "#B4FFFE",
      "light": "#DBFFFF",
      "dark": "#90CCCB"
    },
    "system": {
      "success": "#66B058",
      "info": "#48B2B4",
      "warning": "#D3B954",
      "danger": "#BA674A"
    },
    "text": {
      "black": "#4E4E4E",
      "light": "#EDF1F6"
    }
  },
  "spacings": {
    "xxsmall": "0.8rem",
    "xsmall": "1.6rem",
    "small": "2.4rem",
    "medium": "3.2rem",
    "large": "6.0rem",
    "xlarge": "6.4rem",
    "xxlarge": "12.8rem"
  }
}
